        <packagedDependency>ISPangleAdapter.framework</packagedDependency>
        <packagedDependency>ISUnityAdsAdapter.framework</packagedDependency>
        <packagedDependency>ISVungleAdapter.framework</packagedDependency>
        <packagedDependency>InMobiAdapter.framework</packagedDependency>
        <packagedDependency>InMobiSDK.framework</packagedDependency>
        <packagedDependency>IronSource.framework</packagedDependency>
        <packagedDependency>IronSourceAdapter.framework</packagedDependency>
        <packagedDependency>LiftoffMonetizeAdapter.framework</packagedDependency>
        <packagedDependency>MTGSDK.framework</packagedDependency>
        <packagedDependency>MTGSDKBanner.framework</packagedDependency>
        <packagedDependency>MTGSDKBidding.framework</packagedDependency>
