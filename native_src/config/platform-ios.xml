        <packagedDependency>AppLovinMediationUnityAdsAdapter.framework</packagedDependency>
        <packagedDependency>AppLovinMediationVungleAdapter.framework</packagedDependency>
        <packagedDependency>AppLovinSDK.framework</packagedDependency>
        <packagedDependency>BidMachine.framework</packagedDependency>
        <packagedDependency>BigoADS.framework</packagedDependency>
        <packagedDependency>DTExchangeAdapter.framework</packagedDependency>
        <packagedDependency>FBAudienceNetwork.framework</packagedDependency>
        <packagedDependency>GoogleMobileAds.framework</packagedDependency>
        <packagedDependency>IASDKCore.framework</packagedDependency>
        <packagedDependency>ISAdMobAdapter.framework</packagedDependency>
