        <packagedDependency>OMSDK_Appodeal.framework</packagedDependency>
        <packagedDependency>PAGAdSDK.framework</packagedDependency>
        <packagedDependency>PangleAdapter.framework</packagedDependency>
        <packagedDependency>StackModules.framework</packagedDependency>
        <packagedDependency>StackProductPresentation.framework</packagedDependency>
        <packagedDependency>StackRendering.framework</packagedDependency>
        <packagedDependency>UnityAdapter.framework</packagedDependency>
        <packagedDependency>UnityAds.framework</packagedDependency>
        <packagedDependency>UserMessagingPlatform.framework</packagedDependency>
        <packagedDependency>VungleAdsSDK.framework</packagedDependency>
        <packagedDependency>Yodo1MasCore.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationAdMob.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationApplovin.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationBidMachine.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationBigo.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationFacebook.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationFyber.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationInMobi.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationIronSource.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationMintegral.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationMoloco.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationPangle.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationUnityAds.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationVungle.framework</packagedDependency>
        <packagedDependency>Yodo1MasMediationYodo1.framework</packagedDependency>
        <!-- Source pod frameworks (compiled from source) -->
        <packagedDependency>AFNetworking.framework</packagedDependency>
        <packagedDependency>YDYThinkingSDK.framework</packagedDependency>
        <packagedDependency>YYModel.framework</packagedDependency>
        <!-- Link fixes for the AIR SDK's old system stubs: Swift shim FORCE_LOAD
             markers + Network.framework forwarders (source: ios/stubs/Yodo1MasLinkFixes.c) -->
        <packagedDependency>libYodo1MasLinkFixes.a</packagedDependency>
        <!-- Link-time text stubs (no code, not embedded) for iOS 18 symbols missing
             from the AIR SDK's iOS 17 system stubs; see ios/stubs/*.framework -->
        <packagedDependency>Yodo1MasUIKitCompat.framework</packagedDependency>
        <packagedDependency>Yodo1MasSwiftConcurrencyCompat.framework</packagedDependency>
    </packagedDependencies>

    <linkerOptions>
        <!-- Where dyld finds the 4 dynamic frameworks (Frameworks/ in the .app) -->
        <option>-rpath @executable_path/Frameworks</option>
        <option>-ObjC</option>
        <option>-lz</option>
        <option>-lsqlite3</option>
        <option>-lxml2</option>
        <option>-lc++</option>
        <option>-lresolv</option>
        <option>-lbz2</option>
        <!-- System frameworks required by ad SDKs -->
        <option>-framework AdSupport</option>
        <option>-framework AdServices</option>
        <option>-framework AppTrackingTransparency</option>
        <option>-framework AudioToolbox</option>
        <option>-framework AVFoundation</option>
        <option>-framework CFNetwork</option>
        <option>-framework CoreData</option>
        <option>-framework CoreFoundation</option>
        <option>-framework CoreGraphics</option>
        <option>-framework CoreImage</option>
        <option>-framework CoreLocation</option>
        <option>-framework CoreMedia</option>
        <option>-framework CoreMotion</option>
        <option>-framework CoreServices</option>
        <option>-framework CoreTelephony</option>
        <option>-framework CoreText</option>
        <option>-framework CoreVideo</option>
        <option>-framework ImageIO</option>
        <option>-framework JavaScriptCore</option>
        <option>-framework MediaPlayer</option>
        <option>-framework MessageUI</option>
        <option>-framework Metal</option>
        <option>-framework MetalKit</option>
        <option>-framework MetalPerformanceShaders</option>
        <option>-framework MobileCoreServices</option>
        <option>-framework Network</option>
        <option>-framework QuartzCore</option>
        <option>-framework SafariServices</option>
        <option>-framework Security</option>
        <option>-framework StoreKit</option>
        <option>-framework SwiftUI</option>
        <option>-framework SystemConfiguration</option>
        <option>-framework UIKit</option>
        <option>-framework WebKit</option>
        <!-- Swift runtime (the swiftCompatibility* back-deploy libraries come from
             the AIR SDK's own lib/aot/lib/libSwiftCompat.a; do not add -l flags
             for them, a stock AIR SDK has no such libraries) -->
        <option>-lswiftCore</option>
        <option>-lswiftFoundation</option>
        <option>-lswiftUIKit</option>
        <option>-lswiftDispatch</option>
        <option>-lswiftObjectiveC</option>
        <option>-lswiftCoreFoundation</option>
        <option>-lswiftCoreGraphics</option>
        <option>-lswiftDarwin</option>

        <!-- Swift back-deployment libraries shipped with the AIR SDK (lib/aot/lib) -->
        <option>-lSwiftCompat</option>
        <!--
            NOTE: never put a "$" in a linker option here. On macOS ADT runs the
            link through /bin/sh without quoting, so "$..." is expanded as a shell
            variable and the option is silently corrupted - so the same ANE would link
            differently on macOS and Windows. Use ios/stubs instead.
        -->
    </linkerOptions>

</platform>
